{
  "version": 2,
  "builds": [
    { "src": "api/scraper.js", "use": "@vercel/node" },
    { "src": "api/stream.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/api/(.*)/(.*)",
      "dest": "/api/scraper.js?slug=$1&episode=$2"
    },
    {
      "src": "/api/stream",
      "dest": "/api/stream.js"
    }
  ]
}
